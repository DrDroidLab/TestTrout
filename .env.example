# Copy to .env (gitignored) and fill in. TestTrout loads it automatically.
# .trout/config.yaml references these by NAME and never stores a value.

SUPABASE_URL=https://YOUR-REF.supabase.co
SUPABASE_ANON_KEY=
# Only needed to seed and reset test data. Never reaches a browser context.
SUPABASE_SERVICE_ROLE_KEY=

# Two accounts minimum: proving user A cannot see user B's data needs a B.
TROUT_OWNER_EMAIL=owner@example.test
TROUT_OWNER_PASSWORD=
TROUT_MEMBER_EMAIL=member@example.test
TROUT_MEMBER_PASSWORD=

# One of: ANTHROPIC_API_KEY | OPENAI_API_KEY | MOONSHOT_API_KEY
# Only needed for `trout intent` and `trout propose`. Scanning never calls a model.
MOONSHOT_API_KEY=
